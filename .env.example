# Copy to .env and adjust. Docker Compose reads this file automatically.
# cp .env.example .env

# ---- Ports on the host --------------------------------------------------
FRONTEND_PORT=8080          # production UI (nginx)
BACKEND_PORT=8000           # FastAPI
DEV_FRONTEND_PORT=5173      # Vite dev server (docker-compose.dev.yml)

# ---- Backend ------------------------------------------------------------
# "*" allows any origin (handy on a LAN). Otherwise a comma-separated list:
#   ASR_CORS_ORIGINS=http://localhost:8080,http://192.168.1.50:8080
ASR_CORS_ORIGINS=*

# CPU threads used by ctranslate2 / torch. Roughly your physical core count.
OMP_NUM_THREADS=4

# torch wheel index. CPU default; docker-compose.gpu.yml overrides with cu121.
#   CPU   : https://download.pytorch.org/whl/cpu
#   CUDA  : https://download.pytorch.org/whl/cu121
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu

# Install the fine-tuning stack (transformers/datasets/peft/accelerate/
# bitsandbytes). Adds several GB to the image; only needed for /api/train.
INSTALL_TRAINING=false

# ---- Frontend -----------------------------------------------------------
# Empty => same-origin /api, proxied to the backend by nginx. Set an absolute
# URL only if the UI and API are served from different hosts.
VITE_API_BASE=
BACKEND_UPSTREAM=http://backend:8000

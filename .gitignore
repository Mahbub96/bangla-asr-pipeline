# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# C extensions / Python packaging artefacts.
# Anchored with a leading slash: a bare "lib/" matches at ANY depth and would
# silently swallow frontend/src/lib/, which is application source.
/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
venv/
ENV/
env/

# Local environment / secrets — never commit
.env
.env.*
!.env.example

# Pre-trained models and checkpoints (DO NOT COMMIT)
models/
checkpoints/
output_*/
*.pt
*.pth
*.bin
*.safetensors
*.onnx

# Dataset audio binaries (preserve directory structure via .gitkeep)
data/**/audio/*
!data/**/audio/.gitkeep
data/sources/
data/research/
data/processed/
data/manifests/

# Evaluation output & experiment logs
evaluation_results.csv
test_transcriptions.json
batch_transcriptions.json
reports/
backups/
*.log
runs/
events.out.tfevents.*
.tmp/

# React frontend dependencies and build output
frontend/node_modules/
frontend/dist/
frontend/*.tsbuildinfo

# OS and Editor specific
.DS_Store
._*
Thumbs.db
.vscode/
.idea/
.ssl/
